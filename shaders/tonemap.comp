#version 450
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba16f) readonly  uniform image2D hdrImage;
layout (binding = 1, rgba8)   writeonly uniform image2D ldrImage;

vec3 tonemap(vec3 hdr) {
    return hdr / (hdr + vec3(1.0));
}

// Hash barato, no criptográfico. Solo para dithering.
float hash(vec2 p) {
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

// Stochastic rounding insesgado de un canal.
// v en [0,1] (input ya clampeado), r en [0,1).
// Devuelve entero 0..255 tal que E[resultado] = v*255.
uint sround(float v, float r) {
    float s  = clamp(v, 0.0, 1.0) * 255.0;
    float lo = floor(s);
    float hi = ceil(s);
    if (lo == hi) return uint(lo);
    // P(hi) = s - lo = parte fraccionaria. Insesgado.
    return (r < (s - lo)) ? uint(hi) : uint(lo);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(hdrImage);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec4 hdr    = imageLoad(hdrImage, coord);
    vec3 mapped = tonemap(hdr.rgb);

    // 3 randoms decorrelacionados por píxel (uno por canal)
    vec2 c = vec2(coord);
    vec3 rnd = vec3(hash(c + vec2( 0.0,  0.0)),
                    hash(c + vec2(17.0, 31.0)),
                    hash(c + vec2(53.0, 97.0)));

    uvec3 q = uvec3(sround(mapped.r, rnd.r),
                    sround(mapped.g, rnd.g),
                    sround(mapped.b, rnd.b));

    // Representar q en el dominio UNORM [0,1].
    // El round() del hardware devuelve exactamente q (identidad para 8 bits).
    imageStore(ldrImage, coord, vec4(vec3(q) / 255.0, 1.0));
}